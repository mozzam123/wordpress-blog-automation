# WordPress credentials (Application Password)
# Create an Application Password in WordPress: Users -> your profile -> Application Passwords
WP_SITE_URL=https://example.com
WP_USERNAME=your_username
WP_APP_PASSWORD=your_application_password

# Optional client tuning
WP_REQUEST_TIMEOUT=30
WP_MAX_RETRIES=3
WP_DEFAULT_POST_STATUS=draft
WP_DB_PATH=blog_automation.db
